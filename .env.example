# ==============================================================================
# AI Box Integration & Engine Configuration Template (.env.example)
# ==============================================================================
# This configuration controls the AI Box Gateway and RabbitMQ Task Consumer.
# It allows seamless plug-and-play swapping between:
#   1) Local Simulator Stack (AnythingLLM + LanceDB + Ollama)
#   2) External Standalone AI Box Appliance (External Team's System)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Engine Provider Selection
# ------------------------------------------------------------------------------
# Supported values:
#   - anythingllm      : (Default) Local simulator with AnythingLLM, Ollama, LanceDB
#   - external_ai_box  : External team's standalone AI Box implementing REST API contract
AI_BACKEND_PROVIDER=anythingllm

# ------------------------------------------------------------------------------
# 2. AI Backend Connection Endpoints
# ------------------------------------------------------------------------------
# For local simulator (Docker container on internal network):
#   BACKEND_HOST=anythingllm
#   BACKEND_PORT=3001
#   AI_BACKEND_PROTOCOL=http
#
# For external AI Box appliance (External team's server/IP):
#   BACKEND_HOST=192.168.10.50
#   BACKEND_PORT=8000
#   AI_BACKEND_PROTOCOL=http
BACKEND_HOST=anythingllm
BACKEND_PORT=3001
AI_BACKEND_PROTOCOL=http

# Port where AI Box Gateway listens (exposes secure proxy to Archive frontend)
GATEWAY_PORT=3001

# ------------------------------------------------------------------------------
# 3. Security Tokens & Service Keys
# ------------------------------------------------------------------------------
# Secret shared token used by Gateway & Connector to authenticate with the AI Box backend.
INTERNAL_SERVICE_KEY=ai_box_internal_api_secret_key
DESTINATION_API_KEY=ai_box_internal_api_secret_key

# Gateway Ingestion Payload Maximum Limit (Bytes). Default: 2 MiB (2097152 bytes)
MAX_FILE_SIZE_BYTES=2097152

# Permitted CORS Origins (comma-separated, no trailing slashes)
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://127.0.0.1:80,http://docs.maskan,http://docs.maskan:80

# ------------------------------------------------------------------------------
# 4. Enterprise Archive System Integration
# ------------------------------------------------------------------------------
# URL and Host header of Enterprise Archive for real-time ACL & Session validation
ARCHIVE_OCS_URL=http://archive_proxy:80
ARCHIVE_HOST_HEADER=localhost
ARCHIVE_AUTH_TIMEOUT=5.0

# ------------------------------------------------------------------------------
# 5. RabbitMQ Message Broker (Transactional Outbox Events)
# ------------------------------------------------------------------------------
AMQP_HOST=127.0.0.1
AMQP_PORT=5672
AMQP_USER=guest
AMQP_PASS=guest
AMQP_VHOST=/
AMQP_QUEUE=ai_box.file_events
AMQP_EXCHANGE=archive.events
AMQP_ROUTING_KEY=file.created

# ------------------------------------------------------------------------------
# 6. AI Vector Database & Embedding Model Settings
# ------------------------------------------------------------------------------
VECTOR_DB=lancedb
EMBEDDING_ENGINE=ollama
EMBEDDING_BASE_PATH=http://ollama:11434
EMBEDDING_MODEL_PREF=qwen2.5:0.5b-instruct
OLLAMA_MODEL_PREF=qwen2.5:0.5b-instruct

# ------------------------------------------------------------------------------
# 7. Gateway Session & ACL Caching
# ------------------------------------------------------------------------------
# In-memory TTL (seconds) for caching user workspace ACL permissions
SESSION_ACL_CACHE_TTL=3600
